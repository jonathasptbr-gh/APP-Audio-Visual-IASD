<!-- "Cobrir telão": imagem riscada. Um olho (android.R.drawable.ic_menu_view,
     usado até a v1.18) sugere ESCONDER A VISTA; o que a ação faz é tirar a
     MÍDIA do telão, e é o mesmo símbolo que o botão do app já mostra nesse
     estado. Não há drawable de sistema com imagem riscada — daí este vetor.

     Traçado como caminho preenchido (não stroke) para o sistema poder tingir
     o ícone conforme o tema, como faz com os demais. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Moldura da imagem (evenOdd deixa o miolo vazado). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M19,3H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM19,19H5V5h14V19z" />

    <!-- Montanha (o conteúdo da imagem). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.96,12.29l-2.75,3.54l-1.96,-2.36L6.5,17h11L13.96,12.29z" />

    <!-- Risco na diagonal: um quadrilátero (largura ~2) em vez de stroke, pela
         mesma razão do resto — caminho preenchido aceita tinta do sistema. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.1,3.51L3.51,2.1L21.9,20.49L20.49,21.9Z" />
</vector>
